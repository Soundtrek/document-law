# Local synthetic tests use their explicit fixtures; the web runtime requires real OIDC.
DATABASE_URL=postgresql://juanity:replace-me@127.0.0.1:5432/juanity_law
SAMMA_ENV=development
SAMMA_BASE_URL=https://samma.co.za
SAMMA_DEV_IDENTITY_ENABLED=false
# Explicit memory is permitted only in isolated non-production development/tests.
# Deployed next start must configure S3; there is no automatic fallback.
SAMMA_STORAGE_DRIVER=s3
SAMMA_S3_ENDPOINT=http://juanity-storage:3900
SAMMA_S3_REGION=garage
SAMMA_S3_BUCKET=samma-dev-documents
SAMMA_S3_ACCESS_KEY_ID=replace-outside-git
SAMMA_S3_SECRET_ACCESS_KEY=replace-outside-git
SAMMA_S3_FORCE_PATH_STYLE=true
SAMMA_S3_REQUEST_TIMEOUT_MS=10000
SAMMA_UPLOAD_MAX_BYTES=10485760
SAMMA_UPLOAD_STAGING_DIR=/upload-staging
SAMMA_SCAN_POLICY=not-scanned-dev
SAMMA_OIDC_ISSUER=https://auth.samma.co.za/realms/samma
SAMMA_OIDC_CLIENT_ID=samma-web
SAMMA_OIDC_CLIENT_SECRET=
AUTH_SECRET=
# MFA IS TEMPORARILY DISABLED FOR DEV/INITIAL SETUP.
# Enable before real sensitive data. SAMMA_ENV != development always requires Governance MFA.
SAMMA_GOVERNANCE_MFA_REQUIRED=false
