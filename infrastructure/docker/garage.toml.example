# Copy outside Git to /etc/samma-dev/garage.toml, owned 1000:1000, mode 0600.
metadata_dir = "/var/lib/garage/meta"
data_dir = "/var/lib/garage/data"
db_engine = "lmdb"
replication_factor = 1
consistency_mode = "consistent"
metadata_fsync = true
data_fsync = true
block_ram_buffer_max = "32MiB"
lmdb_map_size = "1G"
rpc_bind_addr = "127.0.0.1:3901"
rpc_public_addr = "127.0.0.1:3901"
rpc_secret = "REPLACE_WITH_PRIVATE_32_BYTE_HEX_SECRET"
[s3_api]
s3_region = "garage"
api_bind_addr = "0.0.0.0:3900"
# No website or admin HTTP API listener. Administration uses local CLI/RPC.
